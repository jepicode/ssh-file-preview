<Window x:Class="SshFilePreview.SshTargetDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sambungkan ke SSH" Height="250" Width="460" MinHeight="250" MinWidth="460"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI">
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <TextBlock Text="Target SSH belum tersambung" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" />
    <TextBlock Grid.Row="1" Text="Masukkan alias SSH (contoh: my-server) atau format user@host." TextWrapping="Wrap" Foreground="{DynamicResource SecondaryTextBrush}" FontSize="12" Margin="0,8,0,12" />
    <TextBox x:Name="TargetBox" Grid.Row="2" Padding="11,8" FontSize="13" Background="{DynamicResource InputBackgroundBrush}" Foreground="{DynamicResource InputForegroundBrush}" BorderBrush="{DynamicResource InputBorderBrush}" BorderThickness="1" />
    <TextBlock x:Name="ValidationMessage" Grid.Row="3" Foreground="{DynamicResource ErrorTextBrush}" FontSize="11" Margin="0,7,0,0" VerticalAlignment="Top" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
      <Button Content="Batal" Style="{StaticResource ThemeButton}" IsCancel="True" MinWidth="82" Padding="12,7" Margin="0,0,8,0" />
      <Button Content="Sambungkan" Style="{StaticResource ThemeButton}" IsDefault="True" MinWidth="112" Padding="12,7" Click="Connect_Click" />
    </StackPanel>
  </Grid>
</Window>
