<Window x:Class="SshFilePreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markdown="clr-namespace:WpfMarkdown.Controls;assembly=WpfMarkdown.Controls"
        Title="SSH File Preview" Icon="pack://application:,,,/app.ico" Height="760" Width="1180" MinHeight="560" MinWidth="860"
        Background="#F5F7FC" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <SolidColorBrush x:Key="Ink" Color="#182238" />
    <SolidColorBrush x:Key="Muted" Color="#77839A" />
    <Style x:Key="SoftButton" TargetType="Button">
      <Setter Property="Background" Value="#FFFFFF" />
      <Setter Property="Foreground" Value="#46536B" />
      <Setter Property="BorderBrush" Value="#E3E8F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#F3F6FC" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.6" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
      <Setter Property="Background" Value="#4263EB" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="BorderBrush" Value="#4263EB" />
      <Setter Property="Padding" Value="18,8" />
    </Style>
    <Style x:Key="PathInput" TargetType="TextBox">
      <Setter Property="Background" Value="White" />
      <Setter Property="Foreground" Value="#25324A" />
      <Setter Property="BorderBrush" Value="#E3E8F1" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="#7890F5" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EntryContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F4F6FB" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EDF1FF" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="EntryTemplate">
      <DockPanel LastChildFill="True">
        <Border Width="34" Height="34" CornerRadius="10" Background="{Binding IconBackground}" Margin="0,0,10,0">
          <Viewbox Width="18" Height="18" Stretch="Uniform">
            <Path x:Name="Glyph" Data="M3,7 L10,7 L12,5 L21,5 L21,19 L3,19 Z" Fill="{Binding IconColor}" Stroke="{Binding IconColor}" StrokeThickness="1.5" StrokeLineJoin="Round" />
          </Viewbox>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Foreground="#27334A" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
          <TextBlock Text="{Binding KindLabel}" Foreground="#8A95A9" FontSize="10" Margin="0,2,0,0" />
        </StackPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="image">
          <Setter TargetName="Glyph" Property="Data" Value="M3,4 L21,4 L21,20 L3,20 Z M5,17 L10,11 L14,15 L17,12 L21,16 M8,7 A1.5,1.5 0 1 1 8,10 A1.5,1.5 0 1 1 8,7" />
          <Setter TargetName="Glyph" Property="Fill" Value="Transparent" />
          <Setter TargetName="Glyph" Property="Stroke" Value="#9254DE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="code">
          <Setter TargetName="Glyph" Property="Data" Value="M8,5 L3,12 L8,19 M16,5 L21,12 L16,19" />
          <Setter TargetName="Glyph" Property="Fill" Value="Transparent" />
          <Setter TargetName="Glyph" Property="Stroke" Value="#168A70" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="text">
          <Setter TargetName="Glyph" Property="Data" Value="M5,3 L15,3 L20,8 L20,21 L5,21 Z M15,3 L15,8 L20,8 M8,13 L17,13 M8,17 L17,17" />
          <Setter TargetName="Glyph" Property="Fill" Value="Transparent" />
          <Setter TargetName="Glyph" Property="Stroke" Value="#6480A8" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="2,0,2,20">
      <Border x:Name="ConnectionBadge" DockPanel.Dock="Right" Background="#FFF4DF" CornerRadius="14" Padding="12,8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="#D28B1E" Margin="0,0,8,0" />
          <TextBlock x:Name="ConnectionStateText" Text="Menghubungkan" Foreground="#986516" FontSize="11" FontWeight="Bold" />
          <TextBlock x:Name="SshTargetText" Text="dansaihomelab" Foreground="#827151" FontSize="11" />
        </StackPanel>
      </Border>
      <StackPanel>
        <TextBlock Text="REMOTE WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#8994A9" />
        <TextBlock Text="File Preview" FontSize="27" FontWeight="SemiBold" Foreground="{StaticResource Ink}" Margin="0,2,0,0" />
        <TextBlock Text="Buka source dan gambar dari server, tanpa terminal." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="UpButton" Grid.Column="0" Style="{StaticResource SoftButton}" Padding="0" Content="←" FontSize="17" Click="UpButton_Click" ToolTip="Folder induk" />
      <TextBox x:Name="PathBox" Grid.Column="1" Margin="9,0" Style="{StaticResource PathInput}" KeyDown="PathBox_KeyDown" />
      <Button Grid.Column="2" Style="{StaticResource PrimaryButton}" Content="Buka folder" Click="GoButton_Click" />
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="White" BorderBrush="#E7EAF1" BorderThickness="1" CornerRadius="14" Padding="13">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="3,1,3,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="BROWSER" FontSize="10" FontWeight="Bold" Foreground="#929DB0" /><TextBlock Text="Folder &amp; file" FontSize="15" FontWeight="SemiBold" Foreground="#26334A" Margin="0,3,0,0" /></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Padding="9,6" Content="↻" FontSize="15" Click="RefreshButton_Click" ToolTip="Muat ulang" />
          </Grid>
          <ListBox x:Name="EntriesList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource EntryContainer}"
                   ItemTemplate="{StaticResource EntryTemplate}" SelectionChanged="EntriesList_SelectionChanged"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="White" BorderBrush="#E7EAF1" BorderThickness="1" CornerRadius="14" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="1,0,1,12">
            <Border x:Name="FileTypeBadge" DockPanel.Dock="Right" Background="#F0F3F9" CornerRadius="10" Padding="9,5" Visibility="Collapsed"><TextBlock x:Name="FileTypeText" Foreground="#62708A" FontSize="10" FontWeight="Bold" /></Border>
            <StackPanel>
              <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="#929DB0" />
              <TextBlock x:Name="PreviewTitle" Text="Pilih file untuk preview" FontSize="15" FontWeight="SemiBold" Foreground="#26334A" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              <TextBlock x:Name="FileSize" Foreground="#8A95A9" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="#F8FAFD" CornerRadius="10" ClipToBounds="True">
            <Grid>
              <markdown:MarkdownViewer x:Name="MarkdownPreview" Visibility="Collapsed" Theme="Light" Background="#F8FAFD" />
              <TextBox x:Name="CodePreview" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="16"
                       Background="#F8FAFD" Foreground="#25334D" FontFamily="Cascadia Code, Consolas" FontSize="12.5" />
              <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#202633">
                <Image x:Name="ImagePreview" Stretch="Uniform" MaxWidth="1100" MaxHeight="900" Margin="12" />
              </ScrollViewer>
              <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="58" Height="58" Background="#EDF1FF" CornerRadius="18" HorizontalAlignment="Center"><TextBlock Text="↗" FontSize="27" Foreground="#5472E8" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock x:Name="EmptyPreview" Text="Pilih file di sebelah kiri" Foreground="#65728A" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Source dan gambar akan tampil di sini" Foreground="#9AA4B6" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="3,12,3,0" LastChildFill="False">
      <TextBlock x:Name="StatusText" Foreground="#758198" FontSize="11" Text="Siap" />
      <TextBlock DockPanel.Dock="Right" Text="File dibaca langsung dari SSH · tidak disimpan lokal" Foreground="#9AA4B6" FontSize="10" />
    </DockPanel>
  </Grid>
</Window>
