<Window x:Class="SshFilePreview.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markdown="clr-namespace:WpfMarkdown.Controls;assembly=WpfMarkdown.Controls"
        Title="SSH File Preview" Icon="pack://application:,,,/app.ico" Height="760" Width="1180" MinHeight="560" MinWidth="860"
        Background="{DynamicResource WindowBackgroundBrush}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <Style x:Key="SoftButton" TargetType="Button">
      <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="13,8" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource ButtonHoverBrush}" /></Trigger>
              <MultiTrigger>
                <MultiTrigger.Conditions>
                  <Condition Property="IsMouseOver" Value="True" />
                  <Condition Property="Tag" Value="Primary" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Surface" Property="Background" Value="{DynamicResource PrimaryButtonHoverBrush}" />
              </MultiTrigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.82" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.6" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
      <Setter Property="Tag" Value="Primary" />
      <Setter Property="Background" Value="{DynamicResource PrimaryButtonBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryButtonForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource PrimaryButtonBorderBrush}" />
      <Setter Property="Padding" Value="18,8" />
    </Style>
    <Style x:Key="ToolbarIconButton" TargetType="Button">
      <Setter Property="Width" Value="40" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="{DynamicResource EntryHoverBrush}" /></Trigger>
              <Trigger Property="IsPressed" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.45" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="PathInput" TargetType="TextBox">
      <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
      <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="12,9" />
      <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Border x:Name="Field" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
              <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Field" Property="BorderBrush" Value="{DynamicResource InputFocusBorderBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="EntryContainer" TargetType="ListBoxItem">
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Row" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource EntryHoverBrush}" /></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="{DynamicResource EntrySelectedBrush}" /></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <DataTemplate x:Key="EntryTemplate">
      <DockPanel LastChildFill="True">
        <Border Width="26" Height="26" CornerRadius="8" Background="{DynamicResource IconTileBackgroundBrush}" Margin="0,0,8,0">
          <Viewbox Width="18" Height="18" Stretch="Uniform">
            <Path x:Name="Glyph" Data="M3,7 L10,7 L12,5 L21,5 L21,19 L3,19 Z" Fill="{Binding IconColor}" Stroke="{Binding IconColor}" StrokeThickness="1.5" StrokeLineJoin="Round" />
          </Viewbox>
        </Border>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="{Binding Name}" Foreground="{DynamicResource EntryNameBrush}" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Name}" />
          <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource EntryMetadataBrush}" FontSize="10" Margin="0,1,0,0" />
        </StackPanel>
      </DockPanel>
      <DataTemplate.Triggers>
        <DataTrigger Binding="{Binding Kind}" Value="image">
          <Setter TargetName="Glyph" Property="Data" Value="M3,4 L21,4 L21,20 L3,20 Z M5,17 L10,11 L14,15 L17,12 L21,16 M8,7 A1.5,1.5 0 1 1 8,10 A1.5,1.5 0 1 1 8,7" />
          <Setter TargetName="Glyph" Property="Fill" Value="Transparent" />
          <Setter TargetName="Glyph" Property="Stroke" Value="#9254DE" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="code">
          <Setter TargetName="Glyph" Property="Data" Value="M8,5 L3,12 L8,19 M16,5 L21,12 L16,19" />
          <Setter TargetName="Glyph" Property="Fill" Value="Transparent" />
          <Setter TargetName="Glyph" Property="Stroke" Value="#168A70" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Kind}" Value="text">
          <Setter TargetName="Glyph" Property="Data" Value="M5,3 L15,3 L20,8 L20,21 L5,21 Z M15,3 L15,8 L20,8 M8,13 L17,13 M8,17 L17,17" />
          <Setter TargetName="Glyph" Property="Fill" Value="Transparent" />
          <Setter TargetName="Glyph" Property="Stroke" Value="#6480A8" />
        </DataTrigger>
      </DataTemplate.Triggers>
    </DataTemplate>
    <ContextMenu x:Key="EntryContextMenu" Style="{StaticResource ThemeContextMenu}" Opened="EntryContextMenu_Opened">
      <MenuItem Header="Copy path" Tag="copyPath" Style="{StaticResource ThemeMenuItem}" Click="CopyEntryPath_Click" />
      <Separator />
      <MenuItem Header="Download file" Tag="download" Style="{StaticResource ThemeMenuItem}" Click="DownloadEntry_Click" />
    </ContextMenu>
  </Window.Resources>
  <Grid Margin="24">
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
    <DockPanel Grid.Row="0" Margin="2,0,2,20">
      <Border x:Name="ConnectionBadge" DockPanel.Dock="Right" Background="{DynamicResource ConnectingBadgeBackgroundBrush}" CornerRadius="14" Padding="12,8" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Ellipse x:Name="ConnectionDot" Width="8" Height="8" Fill="{DynamicResource ConnectingBadgeDotBrush}" Margin="0,0,8,0" VerticalAlignment="Center" />
          <TextBlock x:Name="ConnectionStateText" Text="Menghubungkan" Foreground="{DynamicResource ConnectingBadgeForegroundBrush}" FontSize="11" FontWeight="Bold" Margin="8,0,0,0" VerticalAlignment="Center" />
          <ComboBox x:Name="SshTargetSelector" AutomationProperties.Name="SSH host" Style="{StaticResource ThemeComboBox}" Width="190" Margin="8,0,0,0" VerticalAlignment="Center" SelectionChanged="SshTargetSelector_SelectionChanged" ToolTip="Pilih host SSH" />
          <Button x:Name="AddHostButton" AutomationProperties.Name="Add SSH host" Style="{StaticResource ToolbarIconButton}" Width="36" Height="36" Margin="6,0,0,0" VerticalAlignment="Center" Click="AddHostButton_Click" ToolTip="Tambahkan host">
            <Path Data="M12,4 L12,20 M4,12 L20,12" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
          <Button x:Name="ThemeToggleButton" AutomationProperties.Name="Toggle light/dark theme" Style="{StaticResource ToolbarIconButton}" Width="36" Height="36" Margin="6,0,0,0" VerticalAlignment="Center" Click="ThemeToggleButton_Click" ToolTip="Ganti tema">
            <Path x:Name="ThemeToggleGlyph" Width="16" Height="16" Stretch="Uniform" Fill="Transparent" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
          </Button>
        </StackPanel>
      </Border>
      <StackPanel>
        <TextBlock Text="REMOTE WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" />
        <TextBlock Text="File Preview" FontSize="27" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,2,0,0" />
        <TextBlock Text="Buka source dan gambar dari server, tanpa terminal." FontSize="12" Foreground="{DynamicResource SecondaryTextBrush}" Margin="0,2,0,0" />
      </StackPanel>
    </DockPanel>
    <Grid Grid.Row="1" Margin="0,0,0,16">
      <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Button x:Name="BackButton" AutomationProperties.Name="Back to previous folder" Grid.Column="0" Style="{StaticResource ToolbarIconButton}" Click="BackButton_Click" ToolTip="Folder sebelumnya" IsEnabled="False">
        <Path Data="M17,12 L7,12 M7,12 L12,7 M7,12 L12,17" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Button>
      <Button x:Name="UpButton" AutomationProperties.Name="Go to parent folder" Grid.Column="1" Style="{StaticResource ToolbarIconButton}" Click="UpButton_Click" ToolTip="Folder induk" IsEnabled="False">
        <Path Data="M12,17 L12,7 M12,7 L7,12 M12,7 L17,12" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource PrimaryTextBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
      </Button>
      <TextBox x:Name="PathBox" Grid.Column="2" Margin="9,0" Style="{StaticResource PathInput}" KeyDown="PathBox_KeyDown" />
      <Button x:Name="OpenFolderButton" Grid.Column="3" Style="{StaticResource PrimaryButton}" Content="Buka folder" Click="GoButton_Click" />
    </Grid>
    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="310" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="13">
        <DockPanel>
          <Grid DockPanel.Dock="Top" Margin="3,1,3,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel><TextBlock Text="BROWSER" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrowserHeadingBrush}" /><TextBlock Text="Folder &amp; file" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,3,0,0" /></StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SoftButton}" Padding="9,6" Content="↻" FontSize="15" Click="RefreshButton_Click" ToolTip="Muat ulang" />
          </Grid>
          <ListBox x:Name="EntriesList" BorderThickness="0" Background="Transparent" ItemContainerStyle="{StaticResource EntryContainer}"
                   ItemTemplate="{StaticResource EntryTemplate}" SelectionChanged="EntriesList_SelectionChanged"
                   ContextMenu="{StaticResource EntryContextMenu}" PreviewMouseRightButtonDown="EntriesList_PreviewMouseRightButtonDown"
                   ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" />
        </DockPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource CardBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="16">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <DockPanel Grid.Row="0" Margin="1,0,1,12">
            <Border x:Name="FileTypeBadge" DockPanel.Dock="Right" Background="{DynamicResource FileTypeBadgeBackgroundBrush}" CornerRadius="10" Padding="9,5" Visibility="Collapsed"><TextBlock x:Name="FileTypeText" Foreground="{DynamicResource FileTypeBadgeForegroundBrush}" FontSize="10" FontWeight="Bold" /></Border>
            <StackPanel x:Name="ZoomControls" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0" Visibility="Collapsed">
              <Button x:Name="ZoomOutButton" Style="{StaticResource SoftButton}" Padding="8,4" Content="−" FontSize="13" Click="ZoomOutButton_Click" ToolTip="Zoom out" />
              <ComboBox x:Name="ZoomRatioSelector" Style="{StaticResource ThemeComboBox}" Width="76" Margin="6,0" VerticalContentAlignment="Center" SelectionChanged="ZoomRatioSelector_SelectionChanged" />
              <Button x:Name="ZoomInButton" Style="{StaticResource SoftButton}" Padding="8,4" Content="+" FontSize="13" Click="ZoomInButton_Click" ToolTip="Zoom in" />
            </StackPanel>
            <StackPanel>
              <TextBlock Text="PREVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrowserHeadingBrush}" />
              <TextBlock x:Name="PreviewTitle" Text="Pilih file untuk preview" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" />
              <TextBlock x:Name="FileSize" Foreground="{DynamicResource MutedTextBrush}" FontSize="11" Margin="0,2,0,0" />
            </StackPanel>
          </DockPanel>
          <Border Grid.Row="1" Background="{DynamicResource PreviewBackgroundBrush}" CornerRadius="10" ClipToBounds="True">
            <Grid>
              <markdown:MarkdownViewer x:Name="MarkdownPreview" Visibility="Collapsed" Theme="Light" Background="{DynamicResource PreviewBackgroundBrush}" />
              <TextBox x:Name="CodePreview" Visibility="Collapsed" IsReadOnly="True" AcceptsReturn="True" AcceptsTab="True" TextWrapping="NoWrap"
                       VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0" Padding="16"
                       Background="{DynamicResource PreviewBackgroundBrush}" Foreground="{DynamicResource BodyTextBrush}" FontFamily="Cascadia Code, Consolas" FontSize="12.5" />
              <ScrollViewer x:Name="ImageScroll" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource ImageSurfaceBrush}">
                <Image x:Name="ImagePreview" Stretch="None" Margin="12" RenderTransformOrigin="0,0" />
              </ScrollViewer>
              <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="58" Height="58" Background="{DynamicResource EmptyIconBackgroundBrush}" CornerRadius="18" HorizontalAlignment="Center"><TextBlock Text="↗" FontSize="27" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                <TextBlock x:Name="EmptyPreview" Text="Pilih file untuk preview" Foreground="{DynamicResource EmptyPreviewBrush}" FontSize="13" HorizontalAlignment="Center" Margin="0,14,0,0" />
                <TextBlock Text="Source dan gambar akan tampil di sini" Foreground="{DynamicResource FooterBrush}" FontSize="11" HorizontalAlignment="Center" Margin="0,5,0,0" />
              </StackPanel>
            </Grid>
          </Border>
        </Grid>
      </Border>
    </Grid>
    <DockPanel Grid.Row="3" Margin="3,12,3,0" LastChildFill="False">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource FooterBrush}" FontSize="11" Text="Siap" />
      <TextBlock DockPanel.Dock="Right" Text="File dibaca langsung dari SSH · tidak disimpan lokal" Foreground="{DynamicResource FooterBrush}" FontSize="10" />
    </DockPanel>
  </Grid>
</Window>
